# Public site origin, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://design.radlabs.com

# --- Enquiry delivery: set ONE of the two options below ---------------------
# Without either, /api/enquiry returns 501 and the form falls back to opening
# the visitor's mail client, so enquiries still reach you.

# Option A — POST the enquiry as JSON (Zapier, Make, n8n, your CRM)
# ENQUIRY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef

# Option B — send email via Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ENQUIRY_TO=design@radlabs.com
# ENQUIRY_FROM=website@radlabs.com

# --- Rate limiting ----------------------------------------------------------
# The header your proxy OVERWRITES with the real client address. Set it to
# match your platform, or leave unset to use the rightmost x-forwarded-for hop.
#   nginx -> x-real-ip | Cloudflare -> cf-connecting-ip | Vercel -> x-vercel-forwarded-for
# TRUSTED_IP_HEADER=x-real-ip
